="22" value="128"/><column index="23" value="80"/><column index="24" value="135"/><column index="25" value="135"/><column index="26" value="135"/><column index="27" value="135"/><column index="28" value="135"/><column index="29" value="74"/><column index="30" value="135"/><column index="31" value="135"/><column index="32" value="109"/><column index="33" value="67"/><column index="34" value="98"/><column index="35" value="73"/><column index="36" value="67"/><column index="37" value="151"/><column index="38" value="215"/><column index="39" value="215"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="feedback_360" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="0" mode="0"/></sort><column_widths><column index="1" value="39"/><column index="2" value="85"/><column index="3" value="82"/><column index="4" value="80"/><column index="5" value="101"/><column index="6" value="135"/><column index="7" value="83"/><column index="8" value="77"/><column index="9" value="94"/><column index="10" value="117"/><column index="11" value="72"/><column index="12" value="102"/><column index="13" value="67"/><column index="14" value="82"/><column index="15" value="95"/><column index="16" value="88"/><column index="17" value="300"/><column index="18" value="159"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">UPDATE feedback_360 
SET divergence_score = CASE 
    WHEN MOD(CAST(SUBSTRING(employee_id, 2) AS INT), 5) = 0 THEN 0.05
    WHEN MOD(CAST(SUBSTRING(employee_id, 2) AS INT), 5) = 1 THEN 0.20
    WHEN MOD(CAST(SUBSTRING(employee_id, 2) AS INT), 5) = 2 THEN 0.40
    WHEN MOD(CAST(SUBSTRING(employee_id, 2) AS INT), 5) = 3 THEN 0.60
    ELSE 0.85
END,
interpretation = CASE 
    WHEN MOD(CAST(SUBSTRING(employee_id, 2) AS INT), 5) = 0 
        THEN 'Very Low Divergence - Consensus (Low Power Distance)'
    WHEN MOD(CAST(SUBSTRING(employee_id, 2) AS INT), 5) = 1 
        THEN 'Low Divergence - Weak Power Distance Influence'
    WHEN MOD(CAST(SUBSTRING(employee_id, 2) AS INT), 5) = 2 
        THEN 'Moderate Divergence - Some Power Distance Influence'
    WHEN MOD(CAST(SUBSTRING(employee_id, 2) AS INT), 5) = 3 
        THEN 'High Divergence - Significant Power Distance Influence'
    ELSE 'Very High Divergence - Strong Power Distance Influence'
END
WHERE period_year = 2026;

-- Step 3: Add quarter variations (optional - makes it more realistic)
UPDATE feedback_360 d1
SET divergence_score = d1.divergence_score + 
    CASE 
        WHEN d1.period_quarter = 1 THEN 0.0
        WHEN d1.period_quarter = 2 THEN 0.08
        WHEN d1.period_quarter = 3 THEN 0.05
        WHEN d1.period_quarter = 4 THEN 0.12
        ELSE 0
    END,
interpretation = CASE 
    WHEN d1.divergence_score + 
        CASE 
            WHEN d1.period_quarter = 1 THEN 0.0
            WHEN d1.period_quarter = 2 THEN 0.08
            WHEN d1.period_quarter = 3 THEN 0.05
            WHEN d1.period_quarter = 4 THEN 0.12
            ELSE 0
        END &lt; 0.15 THEN 'Very Low Divergence - Consensus (Low Power Distance)'
    WHEN d1.divergence_score + 
        CASE 
            WHEN d1.period_quarter = 1 THEN 0.0
            WHEN d1.period_quarter = 2 THEN 0.08
            WHEN d1.period_quarter = 3 THEN 0.05
            WHEN d1.period_quarter = 4 THEN 0.12
            ELSE 0
        END &lt; 0.30 THEN 'Low Divergence - Weak Power Distance Influence'
    WHEN d1.divergence_score + 
        CASE 
            WHEN d1.period_quarter = 1 THEN 0.0
            WHEN d1.period_quarter = 2 THEN 0.08
            WHEN d1.period_quarter = 3 THEN 0.05
            WHEN d1.period_quarter = 4 THEN 0.12
            ELSE 0
        END &lt; 0.50 THEN 'Moderate Divergence - Some Power Distance Influence'
    WHEN d1.divergence_score + 
        CASE 
            WHEN d1.period_quarter = 1 THEN 0.0
            WHEN d1.period_quarter = 2 THEN 0.08
            WHEN d1.period_quarter = 3 THEN 0.05
            WHEN d1.period_quarter = 4 THEN 0.12
            ELSE 0
        END &lt; 0.75 THEN 'High Divergence - Significant Power Distance Influence'
    ELSE 'Very High Divergence - Strong Power Distance Influence'
END
WHERE period_year = 2026;</sql><current_tab id="0"/></tab_sql></sqlb_project>
